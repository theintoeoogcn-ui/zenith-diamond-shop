# Copy this file to .env and fill in your real values.
# See README.md for how to get each one.

# Token from @BotFather after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# Your (the admin's) Telegram numeric chat id — where order alerts are sent
ADMIN_CHAT_ID=123456789

# Port the web server runs on
PORT=3000

# Optional: where orders.json is stored. Leave unset for local use.
# On Render (or similar), point this at your mounted persistent disk,
# e.g. /var/data
# DATA_DIR=/var/data
