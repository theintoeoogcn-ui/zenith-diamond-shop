# Copy this file to ".env" in the same folder and fill in real values.
#   cp .env.example .env

# Port the Express server listens on (the storefront + API are served from here)
PORT=3000

# Telegram bot token from @BotFather (Telegram app -> search "BotFather" -> /newbot)
BOT_TOKEN=ExampleToken:REPLACE_ME

# The chat ID that should receive new-order notifications.
# For a personal chat: message @userinfobot on Telegram, it replies with your numeric ID.
# For a group: add the bot to the group, then use a tool like @RawDataBot to read the group's chat id (usually starts with -100).
ADMIN_CHAT_ID=REPLACE_ME

# Optional: a second chat (usually a staff Telegram group) that gets the same
# new-order message with the same Confirm/Reject buttons. Anyone in that
# group can tap Confirm/Reject — Telegram doesn't restrict inline buttons to
# one person, and confirming/rejecting in either chat updates both.
# Leave blank to disable. Get the group's chat ID the same way as above.
GROUP_CHAT_ID=

# Optional: where order data is stored (defaults to ./data/orders.json)
# DATA_DIR=./data

# CRITICAL on Render (or any host with an ephemeral filesystem): without
# these three set, every redeploy/restart wipes server/data/*.json back to
# empty — orders, tournaments, registrations, news posts, prices, ads and
# home stats all reset, and order codes restart from ZE-0001. Setting these
# turns on a durable backup to a Google Sheet: on boot, each *Db.js file
# reloads its last-saved copy from the sheet before anything else runs.
#   1. console.cloud.google.com -> create/select a project.
#   2. APIs & Services -> Library -> enable "Google Sheets API".
#   3. APIs & Services -> Credentials -> Create Credentials -> Service Account
#      -> give it a name -> Done (no extra roles needed).
#   4. Open that service account -> Keys tab -> Add Key -> Create new key
#      -> JSON -> download it. It contains client_email and private_key.
#   5. sheets.new to create a spreadsheet. GOOGLE_SHEET_ID is the long id in
#      its URL, between /d/ and /edit.
#   6. Share that spreadsheet with the service account's client_email
#      (Share button, paste the email, give it Editor access) — without
#      this share step, every read/write will fail with a permission error.
#   7. GOOGLE_SERVICE_ACCOUNT_EMAIL = client_email from the JSON.
#      GOOGLE_PRIVATE_KEY = private_key from the JSON, pasted exactly as it
#      appears there (the literal "\n" sequences in the string are expected
#      — the code un-escapes them at startup).
# Leave all three blank only for local/throwaway testing — never in
# production, or the next deploy silently erases everything.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: email the payment voucher to the customer once their order is
# confirmed (only if they entered an email on the order form). Uses your own
# Gmail account via an App Password — NOT your normal Gmail password:
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords, create one (name it "Zenith"),
#      copy the 16-character password it gives you.
#   3. EMAIL_USER is the Gmail address itself; EMAIL_APP_PASSWORD is that
#      16-character code (spaces don't matter, with or without them is fine).
# Leave both blank to disable voucher emails — orders still work normally.
EMAIL_USER=
EMAIL_APP_PASSWORD=
