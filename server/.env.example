# Copy this file to ".env" in the same folder and fill in real values.
#   cp .env.example .env

# Port the Express server listens on (the storefront + API are served from here)
PORT=3000

# Telegram bot token from @BotFather (Telegram app -> search "BotFather" -> /newbot)
BOT_TOKEN=ExampleToken:REPLACE_ME

# The chat ID that should receive new-order notifications.
# For a personal chat: message @userinfobot on Telegram, it replies with your numeric ID.
# For a group: add the bot to the group, then use a tool like @RawDataBot to read the group's chat id (usually starts with -100).
ADMIN_CHAT_ID=REPLACE_ME

# Optional: where order data is stored (defaults to ./data/orders.json)
# DATA_DIR=./data
